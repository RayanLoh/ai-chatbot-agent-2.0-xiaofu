GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
SUPABASE_URL=
# Backend only; never expose in VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
GUEST_SIGNING_SECRET=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
ALLOWED_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-4-argon,gemini-3.1-pro-preview,gemini-nano-banana-2.1,gemini-3.1-flash-image,gemini-3-pro-image
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Set true only AFTER disabling r2.dev and public custom-domain bucket access.
R2_PRIVATE_BUCKET_CONFIRMED=false
# No real rates are assumed. Supply worst-case rates for each enabled model.
# JSON value example schema only (replace model and every rate before use):
# {"model-id":{"input":0.0,"output":0.0,"image_micro_usd":0}}
MODEL_BUDGETS_JSON={}
MAX_INPUT_TOKENS=16000
MAX_OUTPUT_TOKENS=2048
USER_DAILY_MICRO_USD=1000000
GLOBAL_MONTHLY_MICRO_USD=10000000
USER_DAILY_REQUESTS=50
USER_DAILY_IMAGE_BYTES=20971520
GLOBAL_DAILY_IMAGE_BYTES=209715200
MAX_STORED_IMAGE_BYTES=1073741824
# End-user free trial is independent of the provider's API billing.
FREE_TRIAL_LIMIT=20
FREE_TRIAL_PERIOD=lifetime
# Omit FREE_MODELS to use the default chat model only.
# FREE_MODELS=gemini-3.8-flash
PRO_DAILY_LIMIT=100
PRO_DAILY_MICRO_USD=5000000
# Subscription UI is a template; no payment credentials are needed yet.
PORT=8080
